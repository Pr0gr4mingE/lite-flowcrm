# 1. Chaves do Front-end (Para o cliente conectar no Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://seuid.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_chave_anonima_aqui

# 2. Chaves do Back-end / ORM (Para acesso direto ao banco de dados)
# Usa a porta 6543 (Pooling) para tráfego do dia a dia e rotas de API
DATABASE_URL="postgresql://postgres.[SEU_ID]:[SUA_SENHA]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres"

# Usa a porta 5432 (Direct) para migrações e criação de tabelas
DIRECT_URL="postgresql://postgres.[SEU_ID]:[SUA_SENHA]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"